--Create Database
CREATE DATABASE employeedb;

-- Use Database
USE employeedb ;

--Create Table

	CREATE TABLE employee (
        id INT AUTO_INCREMENT PRIMARY KEY,
 	    name VARCHAR(50),
   	    department VARCHAR(50),
        salary DOUBLE
     );
     
     
-- Add Employee
 INSERT INTO employee(name, department, salary)
    VALUES ('Shreya','IT', 50000) ,
    ('Rahul', 'Finance', 45000),
    ('Rishabh', 'HR', 48000),
    ('Sivam', 'Sales' , 30000),
    ('Shristi', 'IT', 60000),
    ('Kriti', 'Finance', 35000);
    
